# ─────────────────────────────────────────────────────────────
# terraform.tfvars  –  ejemplo para entorno de producción
# Copiar como terraform.tfvars y ajustar antes de aplicar.
# NO commitear este archivo con credenciales reales.
# ─────────────────────────────────────────────────────────────

aws_region   = "us-east-1"
project_name = "ms-reto4"
environment  = "prod"

# Networking
vpc_cidr        = "10.0.0.0/16"
public_subnets  = ["10.0.1.0/24", "10.0.2.0/24"]
private_subnets = ["10.0.10.0/24", "10.0.20.0/24"]

# EKS
kubernetes_version  = "1.29"
node_instance_types = ["t3.medium"]
node_desired_size   = 3
node_min_size       = 2
node_max_size       = 10

# RDS / Aurora
db_instance_class = "db.r6g.large"
db_name           = "microservicesdb"
db_username       = "dbadmin"
db_password       = "CHANGE_ME_strong_password_123!"   # usar Secrets Manager en prod

# ElastiCache
redis_node_type = "cache.t3.micro"

# JWT (Auth0 / Cognito / custom issuer)
jwt_issuer   = "https://your-auth-domain.auth0.com/"
jwt_audience = "https://api.ms-reto4.com"

# Monitoring
alarm_email = "devops@yourcompany.com"
