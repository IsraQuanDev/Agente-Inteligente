{
  "info": {
    "name": "Microservices Reto 4 — API Collection",
    "description": "Complete Postman collection for all 6 microservices. Set {{base_url}} and {{jwt_token}} variables before running.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_postman_id": "ms-reto4-collection-v1"
  },
  "variable": [
    { "key": "base_url",   "value": "https://your-api-id.execute-api.us-east-1.amazonaws.com/prod" },
    { "key": "jwt_token",  "value": "" },
    { "key": "user_id",    "value": "" },
    { "key": "product_id", "value": "" },
    { "key": "order_id",   "value": "" },
    { "key": "payment_id", "value": "" }
  ],
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{jwt_token}}", "type": "string" }]
  },
  "item": [
    {
      "name": "🔐 Auth Service",
      "item": [
        {
          "name": "Register User",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{base_url}}/auth/register",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123!\",\n  \"firstName\": \"John\",\n  \"lastName\": \"Doe\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "const r = pm.response.json();",
                "pm.collectionVariables.set('jwt_token', r.accessToken);",
                "pm.collectionVariables.set('user_id', r.user.id);"
              ]
            }
          }]
        },
        {
          "name": "Login",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{base_url}}/auth/login",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"test@example.com\",\n  \"password\": \"SecurePass123!\"\n}"
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "const r = pm.response.json();",
                "pm.collectionVariables.set('jwt_token', r.accessToken);"
              ]
            }
          }]
        },
        {
          "name": "Refresh Token",
          "request": {
            "auth": { "type": "noauth" },
            "method": "POST",
            "url": "{{base_url}}/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{ \"refreshToken\": \"{{refresh_token}}\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Validate Token (protected)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/auth/validate"
          }
        }
      ]
    },
    {
      "name": "👤 User Service",
      "item": [
        {
          "name": "Get My Profile",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/me"
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 200', () => pm.response.to.have.status(200));",
                "pm.test('Has id', () => pm.expect(pm.response.json()).to.have.property('id'));"
              ]
            }
          }]
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/users/me",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Jane\",\n  \"lastName\": \"Smith\",\n  \"phone\": \"+1234567890\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get User by ID (admin)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/users/{{user_id}}"
          }
        },
        {
          "name": "List Users (admin)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/users?page=1&limit=20",
              "query": [
                { "key": "page",  "value": "1" },
                { "key": "limit", "value": "20" }
              ]
            }
          }
        }
      ]
    },
    {
      "name": "📦 Product Service",
      "item": [
        {
          "name": "List Products",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/products?page=1&limit=20&category=electronics",
              "query": [
                { "key": "page",     "value": "1" },
                { "key": "limit",    "value": "20" },
                { "key": "category", "value": "electronics" }
              ]
            }
          }
        },
        {
          "name": "Get Product",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/products/{{product_id}}"
          }
        },
        {
          "name": "Create Product (admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/products",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Wireless Headphones\",\n  \"description\": \"Premium noise-cancelling headphones\",\n  \"price\": 299.99,\n  \"stock\": 100,\n  \"category\": \"electronics\",\n  \"sku\": \"WH-001\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('product_id', pm.response.json().id);"
              ]
            }
          }]
        },
        {
          "name": "Update Product Stock",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/products/{{product_id}}/stock",
            "body": {
              "mode": "raw",
              "raw": "{ \"quantity\": 50, \"operation\": \"add\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "🛒 Order Service",
      "item": [
        {
          "name": "Create Order",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/orders",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"items\": [\n    { \"productId\": \"{{product_id}}\", \"quantity\": 2 }\n  ],\n  \"shippingAddress\": {\n    \"street\": \"123 Main St\",\n    \"city\": \"León\",\n    \"state\": \"GTO\",\n    \"country\": \"MX\",\n    \"zip\": \"37000\"\n  }\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('order_id', pm.response.json().id);"
              ]
            }
          }]
        },
        {
          "name": "Get Order",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders/{{order_id}}"
          }
        },
        {
          "name": "List My Orders",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/orders?status=all&page=1&limit=10"
          }
        },
        {
          "name": "Cancel Order",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/orders/{{order_id}}/cancel",
            "body": {
              "mode": "raw",
              "raw": "{ \"reason\": \"Customer request\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "💳 Payment Service",
      "item": [
        {
          "name": "Create Payment Intent",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/intent",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"orderId\": \"{{order_id}}\",\n  \"currency\": \"usd\",\n  \"paymentMethod\": \"card\"\n}",
              "options": { "raw": { "language": "json" } }
            }
          },
          "event": [{
            "listen": "test",
            "script": {
              "exec": [
                "pm.test('Status 201', () => pm.response.to.have.status(201));",
                "pm.collectionVariables.set('payment_id', pm.response.json().paymentId);"
              ]
            }
          }]
        },
        {
          "name": "Confirm Payment",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/{{payment_id}}/confirm",
            "body": {
              "mode": "raw",
              "raw": "{ \"paymentMethodId\": \"pm_card_visa\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Get Payment Status",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/payments/{{payment_id}}"
          }
        },
        {
          "name": "Refund Payment (admin)",
          "request": {
            "method": "POST",
            "url": "{{base_url}}/payments/{{payment_id}}/refund",
            "body": {
              "mode": "raw",
              "raw": "{ \"amount\": 299.99, \"reason\": \"product_not_received\" }",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "🔔 Notification Service",
      "item": [
        {
          "name": "Get My Notifications",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/notifications?unread=true&page=1&limit=20"
          }
        },
        {
          "name": "Mark as Read",
          "request": {
            "method": "PATCH",
            "url": "{{base_url}}/notifications/mark-read",
            "body": {
              "mode": "raw",
              "raw": "{ \"ids\": [\"notif-id-1\", \"notif-id-2\"] }",
              "options": { "raw": { "language": "json" } }
            }
          }
        },
        {
          "name": "Update Preferences",
          "request": {
            "method": "PUT",
            "url": "{{base_url}}/notifications/preferences",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": true,\n  \"push\": true,\n  \"orderUpdates\": true,\n  \"promotions\": false\n}",
              "options": { "raw": { "language": "json" } }
            }
          }
        }
      ]
    },
    {
      "name": "🩺 Health Checks",
      "item": [
        {
          "name": "API Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/health"
          }
        },
        {
          "name": "Auth Health",
          "request": {
            "auth": { "type": "noauth" },
            "method": "GET",
            "url": "{{base_url}}/auth/health"
          }
        }
      ]
    }
  ]
}
